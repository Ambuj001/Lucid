{
  "manifest_version": 3,
  "name": "CARDWISE",
  "version": "1.0.0",
  "description": "AI-powered credit card recommendation engine. Save more on every checkout.",
  "permissions": ["storage", "tabs", "activeTab", "clipboardWrite", "identity", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "*://amazon.in/*",
        "*://*.amazon.in/*",
        "*://flipkart.com/*",
        "*://*.flipkart.com/*",
        "*://myntra.com/*",
        "*://*.myntra.com/*",
        "*://ajio.com/*",
        "*://*.ajio.com/*",
        "*://meesho.com/*",
        "*://*.meesho.com/*",
        "*://nykaa.com/*",
        "*://*.nykaa.com/*",
        "*://swiggy.com/*",
        "*://*.swiggy.com/*",
        "*://zomato.com/*",
        "*://*.zomato.com/*",
        "*://irctc.co.in/*",
        "*://*.irctc.co.in/*",
        "*://makemytrip.com/*",
        "*://*.makemytrip.com/*",
        "*://goibibo.com/*",
        "*://*.goibibo.com/*",
        "*://bigbasket.com/*",
        "*://*.bigbasket.com/*",
        "*://blinkit.com/*",
        "*://*.blinkit.com/*",
        "*://croma.com/*",
        "*://*.croma.com/*",
        "*://flipkart.com/*",
        "*://*.flipkart.com/*",
        "*://myntra.com/*",
        "*://*.myntra.com/*",
        "*://snapdeal.com/*",
        "*://*.snapdeal.com/*",
        "*://tatacliq.com/*",
        "*://*.tatacliq.com/*",
        "*://shopclues.com/*",
        "*://*.shopclues.com/*",
        "*://paytmmall.com/*",
        "*://*.paytmmall.com/*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3000/*"
      ],
      "js": ["dashboard_sync.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CARDWISE",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
